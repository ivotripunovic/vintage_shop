# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=vintage_shop
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key

# AWS S3 (future use)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=

# Site Settings
SITE_NAME=Vintage Shop
SITE_DOMAIN=localhost:8000

# Coming Soon Mode — set COMING_SOON=True to show coming soon page to visitors
# Staff/superusers always bypass it. Set a secret to allow preview via ?preview=<secret>
COMING_SOON=False
COMING_SOON_SECRET=

# Social Auth — Google
# Create credentials at https://console.cloud.google.com/ → APIs & Services → Credentials
# Add to Django admin: Social Applications → Add → Google
# (No env vars needed; credentials are stored in DB via Django admin)

# Social Auth — Facebook
# Create app at https://developers.facebook.com/ → Add a Use Case → Facebook Login
# Add to Django admin: Social Applications → Add → Facebook
# (No env vars needed; credentials are stored in DB via Django admin)

# Social Auth — Apple (requires paid Apple Developer account + HTTPS domain)
# Create app at https://developer.apple.com/ → Certificates, IDs & Profiles → Sign In with Apple
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_SECRET=
# Multi-line private key: replace actual newlines with \n before pasting here
APPLE_PRIVATE_KEY=
