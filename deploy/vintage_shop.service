[Unit]
Description=Vintage Shop Gunicorn Daemon
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=django
Group=www-data
RuntimeDirectory=vintage_shop
WorkingDirectory=/srv/django/apps/vintage_shop
EnvironmentFile=/srv/django/apps/vintage_shop/.env
ExecStart=/srv/django/apps/vintage_shop/venv/bin/gunicorn config.wsgi:application -c /srv/django/apps/vintage_shop/deploy/gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
Restart=on-failure
RestartSec=5

# Security hardening
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/django/apps/vintage_shop/media
ReadWritePaths=/srv/django/apps/vintage_shop/logs
ReadWritePaths=/srv/django/apps/vintage_shop/staticfiles
ReadWritePaths=/run/vintage_shop
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
